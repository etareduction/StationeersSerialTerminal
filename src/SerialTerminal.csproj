<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9</LangVersion>
    <AssemblyName>SerialTerminal</AssemblyName>
    <RootNamespace>SerialTerminal</RootNamespace>
    <Version>0.4.3</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Build straight into mod/ so that folder IS the deployable mod and can be symlinked into the game. -->
    <OutputPath>$(MSBuildProjectDirectory)/../mod/</OutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <DebugType>none</DebugType>
    <!-- Run ./setup.sh to populate it. -->
    <LibPath>$(MSBuildProjectDirectory)/../lib</LibPath>
  </PropertyGroup>

  <Target Name="CheckLibPath" BeforeTargets="BeforeResolveReferences">
    <Error Condition="!Exists('$(LibPath)/Assembly-CSharp.dll')"
           Text="No reference assemblies in $(LibPath). Run ./setup.sh from the repo root to link them from your Stationeers install." />
  </Target>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(LibPath)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(LibPath)/Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(LibPath)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(LibPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(LibPath)/UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(LibPath)/UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(LibPath)/UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(LibPath)/Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RG.ImGui">
      <HintPath>$(LibPath)/RG.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RG.ImGui.Unity">
      <HintPath>$(LibPath)/RG.ImGui.Unity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UniTask">
      <HintPath>$(LibPath)/UniTask.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(LibPath)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(LibPath)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LaunchPadBooster">
      <HintPath>$(LibPath)/LaunchPadBooster.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
