# Norsec TTY-6 serial terminal - self test
# IC housing pin d0 -> Serial Terminal
alias term d0
alias n r0
alias c r1
alias p r2

define ADDR_DATA 0
define ADDR_STR 1
define ADDR_COUNT 2
define ADDR_CTRL 3
define ADDR_ROW 4
define ADDR_COL 5

define CH_BS 8
define CH_LF 10
define CH_CR 13
define CH_DEL 127
define CH_NEL 133

# --- 1. bring the screen up ---------------------------
s term On 1
put term ADDR_CTRL 2     # flush input FIFO
put term ADDR_CTRL 3     # clear overflow flag
put term ADDR_CTRL 1     # clear screen

# --- 2. packed-string writes (address 1) --------------
put term ADDR_STR STR("TTY-6 ")
put term ADDR_STR STR("SELFTE")
put term ADDR_STR STR("ST")
put term ADDR_DATA CH_NEL

# --- 3. Setting logic-write should print too ----------
s term Setting STR("VIA-ST")
put term ADDR_DATA CH_NEL

# --- 4. single characters (address 0) -----------------
move n 65
charloop:
put term ADDR_DATA n
add n n 1
blt n 91 charloop        # A..Z
put term ADDR_DATA CH_NEL

# --- 5. control characters ----------------------------
put term ADDR_STR STR("BKSPX")
put term ADDR_DATA CH_DEL # destructive backspace: the X must disappear
put term ADDR_DATA CH_NEL
put term ADDR_STR STR("XXXXXX")
put term ADDR_DATA CH_CR # CR: cursor back to column 0, column kept on LF
put term ADDR_STR STR("CR-OK ")
put term ADDR_DATA CH_LF # bare LF: next row, column unchanged (col 6)
put term ADDR_STR STR("LF-OK ")
put term ADDR_DATA CH_NEL

# --- 6. buffered output mode --------------------------
put term ADDR_CTRL 5     # DATA writes now print packed strings
put term ADDR_DATA STR("BUFOUT")
put term ADDR_CTRL 4     # back to unbuffered
put term ADDR_DATA CH_NEL

# --- 7. cursor addressing (row 15, col 20) ------------
put term ADDR_ROW 15
put term ADDR_COL 20
put term ADDR_STR STR("ADDR15")
get n term ADDR_ROW      # expect 15
get c term ADDR_COL      # expect 26
put term ADDR_ROW 17
put term ADDR_COL 0

# --- 8. status registers, FIFO still empty ------------
get n term ADDR_COUNT    # expect 0
get c term ADDR_CTRL     # expect 0 (unbuffered, no input, no overflow)
add n n 48
add c c 48
put term ADDR_STR STR("CNT=")
put term ADDR_DATA n
put term ADDR_STR STR(" ST=")
put term ADDR_DATA c
put term ADDR_DATA CH_NEL
put term ADDR_STR STR("TYPE.")
put term ADDR_DATA CH_NEL

# --- 9. echo loop: click the screen and type ----------
# Keystrokes arrive one by one: Enter as CR, Backspace as BS.
echo:
yield
l n term Quantity        # logic view of the FIFO
blez n echo
get p term ADDR_STR      # peek, must not consume
get c term ADDR_DATA     # pop
bne c p mismatch
bne c CH_CR notcr
move c CH_NEL            # echo Enter as a full newline
notcr:
bne c CH_BS notbs
move c CH_DEL            # echo Backspace as a destructive rubout
notbs:
put term ADDR_DATA c     # echo back to the glass
j echo

mismatch:
put term ADDR_DATA CH_NEL
put term ADDR_STR STR("PEEKNE")
put term ADDR_STR STR("POP")
put term ADDR_DATA CH_NEL
j echo
